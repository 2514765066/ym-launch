{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["src/renderer/**/*", "src/preload/index.d.ts", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@shared/type": ["./src/shared/type.ts"],
      "@shared/app-info": ["./src/shared/app-info.ts"]
    }
  }
}
