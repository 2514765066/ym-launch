{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["vite.config.*", "src/**/*"],
  "exclude": ["src/renderer"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@/*": ["./src/main/*"],
      "@shared/type": ["./src/shared/type.ts"],
      "@shared/app-info": ["./src/shared/app-info.ts"]
    }
  }
}
